{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoMetadataValidation",
  "description": "Output schema for validate_metadata.py",
  "type": "object",
  "required": ["valid", "summary", "issue_count", "warning_count", "details"],
  "properties": {
    "valid": { "type": "boolean" },
    "summary": { "type": "string", "enum": ["PASS", "FAIL"] },
    "issue_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "details": {
      "type": "object",
      "required": ["title", "description", "tags", "hashtags", "chapters"],
      "properties": {
        "title": { "type": "object" },
        "description": { "type": "object" },
        "tags": { "type": "object" },
        "hashtags": { "type": "object" },
        "chapters": { "type": "object" }
      }
    },
    "all_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "all_warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
